# ---- China mainland mirrors (npmmirror) ----
registry=https://registry.npmmirror.com

# Node.js headers / node-gyp
disturl=https://npmmirror.com/mirrors/node
node_mirror=https://npmmirror.com/mirrors/node

# Common native / binary package mirrors
sass_binary_site=https://npmmirror.com/mirrors/node-sass
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
puppeteer_download_base_url=https://cdn.npmmirror.com/binaries/chrome-for-testing
chromedriver_cdnurl=https://npmmirror.com/mirrors/chromedriver
operadriver_cdnurl=https://npmmirror.com/mirrors/operadriver
phantomjs_cdnurl=https://npmmirror.com/mirrors/phantomjs
selenium_cdnurl=https://npmmirror.com/mirrors/selenium
node_inspector_cdnurl=https://npmmirror.com/mirrors/node-inspector

# ---- Project pnpm settings ----
# Required by zotero-types when using pnpm
# @see https://github.com/windingwind/zotero-types
public-hoist-pattern[]=*@types/bluebird*

# zotero-types depends on pdfjs-dist via git; allow exotic subdeps
block-exotic-subdeps=false
